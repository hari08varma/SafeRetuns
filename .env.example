# Copy to services/.env and fill in. Never commit real secrets.

# none (structured input + template replies) | deepseek
LLM_PROVIDER=none
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek-V4.1-Flash
LLM_MODEL=deepseek-flash
DATABASE_URL=postgresql://returns:returns@localhost:5432/returns


# Security (required). Generate:
#   JWT_SECRET:          python -c "import secrets; print(secrets.token_urlsafe(48))"
#   PII_ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   PII_INDEX_KEY:       python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
PII_ENCRYPTION_KEY=
PII_INDEX_KEY=
