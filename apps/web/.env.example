# Firebase Phone Auth (Firebase console > Project settings > Your apps > Web app).
# Leave empty to use the development OTP flow (requires DEV_OTP_ECHO=true on the API).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Where the API runs (Next proxies /api to it).
API_URL=http://localhost:8000
